{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": false,                  
        "skipLibCheck": true 
    },
    "include": ["src/**/*.ts", "routes/**/*.ts", "src/prisma/seed.ts"],
    "exclude": ["node_modules"]
}
